// ==========================================
// TRACCAR API & FIREBASE NOTIFICATION BACKEND
// ==========================================

class TraccarFirebaseSync {
  /// Firebase FCM Push Token ko Traccar API `/api/users/{id}` par user attributes me register karna
  static Future<bool> syncFcmTokenToTraccarUser({
    required String baseUrl,
    required int userId,
    required String fcmToken,
    required String sessionCookie,
  }) async {
    try {
      final cleanUrl = baseUrl.endsWith('/') ? baseUrl.substring(0, baseUrl.length - 1) : baseUrl;

      // Fetch user details from /api/users/{id}
      final getUserUrl = Uri.parse('$cleanUrl/api/users/$userId');
      final getResponse = await http.get(
        getUserUrl,
        headers: {
          'Accept': 'application/json',
          'Cookie': sessionCookie,
        },
      );

      if (getResponse.statusCode == 200) {
        final Map<String, dynamic> userData = jsonDecode(getResponse.body);
        final Map<String, dynamic> attributes = userData['attributes'] != null
            ? Map<String, dynamic>.from(userData['attributes'])
            : {};

        // Sync FCM Token with Traccar user attributes
        attributes['notificationTokens'] = fcmToken;
        userData['attributes'] = attributes;

        // Save back via /api/users/{id}
        final putResponse = await http.put(
          getUserUrl,
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
            'Cookie': sessionCookie,
          },
          body: jsonEncode(userData),
        );

        return putResponse.statusCode == 200;
      }
    } catch (_) {}
    return false;
  }
}
