class Indicator extends StatelessWidget {
  final Color? color;
  final String? text;
  final bool? isSquare;
  final double? size;
  final Color? textColor;

  const Indicator({
    Key? key,
    this.color,
    this.text,
    this.isSquare,
    this.size = 16,
    this.textColor = const Color(0xff505050),
  }) : super(key: key);

  @override
  Widget build(BuildContext context) {
    return Row(
      children: <Widget>[
        Container(
          width: size,
          height: size,
          decoration: BoxDecoration(
            shape: isSquare! ? BoxShape.rectangle : BoxShape.circle,
            color: color,
          ),
        ),
        const SizedBox(
          width: 4,
        ),
        Text(
          text!,
          style: TextStyle(
              fontSize: 16, fontWeight: FontWeight.bold, color: textColor),
        )
      ],
    );
  }
}

typedef void OnWidgetSizeChange(Size size);

class MeasureSize extends StatefulWidget {
  final Widget? child;
  final OnWidgetSizeChange? onChange;

  const MeasureSize({
    Key? key,
    @required this.onChange,
    @required this.child,
  }) : super(key: key);

  @override
  _MeasureSizeState createState() => _MeasureSizeState();
}

class _MeasureSizeState extends State<MeasureSize> {
  @override
  Widget build(BuildContext context) {
    SchedulerBinding.instance.addPostFrameCallback(postFrameCallback);
    return Container(
      key: widgetKey,
      child: widget.child,
    );
  }

  var widgetKey = GlobalKey();
  var oldSize;

  void postFrameCallback(_) {
    var context = widgetKey.currentContext;
    if (context == null) return;

    var newSize = context.size;
    if (oldSize == newSize) return;

    oldSize = newSize;
    widget.onChange!(newSize!);
  }
}

enum vehicleType { All, Active, Inactive, Idle, Offline, NotConnected, Expired }

class FleetFragment extends StatefulWidget {
  static bool showingCircular = true;
  @override
  _FleetFragmentState createState() => _FleetFragmentState();
}

class _FleetFragmentState extends State<FleetFragment>
    with AutomaticKeepAliveClientMixin<FleetFragment> {
  int? touchedIndex;
  Size logoCenterPosition = Size(0, 0);
  vehicleType vehicle = vehicleType.All;
  List<int> _movingIMEIArray = [];
  List<int> _stoppedIMEIArray = [];
  List<int> _idleIMEIArray = [];
  List<int> _noDataIMEIArray = [];
  List<int> _offlineIMEIArray = [];
  List<int> _expireIMEIArray = [];
  List<int> finalIMEIArray = [];

  @override
  void initState() {
    super.initState();
  }

  @override
  void dispose() {
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    super.build(context);
    return Scaffold(
      floatingActionButton: FleetFragment.showingCircular
          ? null
          : Container(
              width: 50.0,
              height: 50.0,
              margin: EdgeInsets.only(bottom: 70, right: 15),
              child: new RawMaterialButton(
                  shape: new CircleBorder(),
                  elevation: 15.0,
                  fillColor: Globals.appColor,
                  child: Icon(
                    Icons.pie_chart,
                    size: 15,
                    color: Color(0xFFF6F6F6),
                  ),
                  onPressed: () {
                    setState(() {
                      FleetFragment.showingCircular = true;
                    });
                  })),
      backgroundColor: Color(0xFFF6F6F6),
      body: StreamBuilder<List<HomeItem>>(
          stream: Globals.homeBloc!.homeListStream,
          builder: (context, snapshot) {
            if (snapshot.data == null ||
                snapshot.hasError ||
                snapshot.data!.length == 0) {
              return Center(
                  child: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(
                    'Fetching data for first time...',
                    maxLines: 2,
                    textAlign: TextAlign.center,
                    style: TextStyle(
                        color: Globals.appColor,
                        fontSize: 14,
                        decoration: TextDecoration.none,
                        letterSpacing: 1,
                        fontFamily: 'Montserrat'),
                  ),
                  Padding(
                    padding:
                        const EdgeInsets.only(top: 10, left: 40, right: 40),
                    child: CircularProgressIndicator(
                      backgroundColor: Colors.transparent,
                      strokeWidth: 3,
                      valueColor:
                          new AlwaysStoppedAnimation<Color>(Globals.appColor),
                    ),
                  ),
                ],
              ));
            } else {
              _movingIMEIArray.clear();
              _stoppedIMEIArray.clear();
              _idleIMEIArray.clear();
              _noDataIMEIArray.clear();
              _offlineIMEIArray.clear();
              _expireIMEIArray.clear();
              for (int index = 0; index < snapshot.data!.length; index++) {
                /* if (snapshot.data[index].expired) {
                  _expireIMEIArray.add(index);
                } else*/
                {
                  switch (snapshot.data![index].status) {
                    case "m":
                      _movingIMEIArray.add(index);
                      break;
                    case "s":
                      _stoppedIMEIArray.add(index);
                      break;
                    case "i":
                      _idleIMEIArray.add(index);
                      break;
                    case "off":
                      _offlineIMEIArray.add(index);
                      break;
                    case "false":
                      _noDataIMEIArray.add(index);
                      break;
                  }
                }
              }
              return WillPopScope(
                onWillPop: () async {
                  if (!FleetFragment.showingCircular) {
                    setState(() {
                      FleetFragment.showingCircular = true;
                    });
                    return false;
                  }
                  return true;
                },
                child: AnimatedSwitcher(
                  duration: Duration(milliseconds: 500),
                  child: FleetFragment.showingCircular
                      ? Container(
                          width: MediaQuery.of(context).size.width / 1,
                          height: MediaQuery.of(context).size.height / 1,
                          child: ListView.builder(
                              itemCount: 1,
                              itemBuilder: (BuildContext context, int index) {
                                return Card(
                                  shape: RoundedRectangleBorder(
                                      borderRadius:
                                          BorderRadius.all(Radius.circular(5))),
                                  elevation: 5,
                                  color: Colors.white,
                                  child: Center(
                                    child: Padding(
                                      padding: const EdgeInsets.only(
                                          top: 70.0, bottom: 70),
                                      child: Column(
                                        mainAxisAlignment:
                                            MainAxisAlignment.center,
                                        children: <Widget>[
                                          Stack(
                                            children: <Widget>[
                                              MeasureSize(
                                                onChange: (size) {
                                                  setState(() {
                                                    logoCenterPosition = size;
                                                  });
                                                },
                                                child: Material(
                                                  color: Colors.transparent,
                                                  elevation: 20,
                                                  shape: CircleBorder(),
                                                  child: Container(
                                                      width:
                                                          MediaQuery.of(context)
                                                                  .size
                                                                  .width /
                                                              1,
                                                      height: 150,
                                                      child: PieChart(
                                                        PieChartData(
                                                            pieTouchData: PieTouchData(
                                                                touchCallback:
                                                                    (pieTouchResponse,
                                                                        val) {}),
                                                            borderData:
                                                                FlBorderData(
                                                              show: false,
                                                            ),
                                                            centerSpaceColor:
                                                                Colors.white,
                                                            sectionsSpace: 0,
                                                            centerSpaceRadius:
                                                                70,
                                                            sections:
                                                                showingSections()),
                                                      )),
                                                ),
                                              ),
                                              Positioned(
                                                  left: logoCenterPosition.width /
                                                              2 ==
                                                          null
