  Widget buildCard(int index, BuildContext context, HomeListItem homeItemList) {
    return Container();
  }

  List<PieChartSectionData>? showingSections() {
    return List.generate(6, (i) {
      final isTouched = i == touchedIndex;
      final double radius = isTouched ? 60 : 40;
      switch (i) {
        case 0:
          return PieChartSectionData(
            color: Colors.red,
            value: _stoppedIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        case 1:
          return PieChartSectionData(
            color: Colors.green,
            value: _movingIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        case 2:
          return PieChartSectionData(
            color: Color(0xFFF4A445),
            value: _idleIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        case 3:
          return PieChartSectionData(
            color: Colors.grey,
            value: _offlineIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        case 4:
          return PieChartSectionData(
            color: Colors.blue,
            value: _noDataIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        case 5:
          return PieChartSectionData(
            color: Colors.brown,
            value: _expireIMEIArray.length.toDouble(),
            title: '',
            radius: radius,
          );
        default:
          return PieChartSectionData();
      }
    });
  }

  @override
  bool get wantKeepAlive => false;
}
