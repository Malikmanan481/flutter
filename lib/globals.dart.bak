  static List<String> imeiArray = [];
  static HomeBloc? homeBloc;
  static NotificationBloc? notificationBloc;
  static bool dataLoaded = false;
  static bool fetchedLogin = false;
  static bool fetchedSettings = false;
  static bool fetchedObject = false;

  //1. WhiteLabeling values start here
  // static String name = 'Speedotrack';=
  static String name = 'infinity';
  static Color appColor = Color(0xff00ac3c);
  static String baseUrl = 'http://peace.carminetracking.com'; //shoaib,pakistan1122

  static String websiteChatBot = '';
  static String whatsapp = '923016122983';
  static String mobileNumber = '+923016122983';
