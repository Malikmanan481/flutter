                    },
                    child: Container(
                      height: double.infinity,
                      child: Row(
                        children: <Widget>[
                          Align(
                            alignment: Alignment.centerLeft,
                            child: Text(
                                '${dtf!.split(' ')[0]} to ${dtt!.split(' ')[0]}',
                                style: TextStyle(
                                    color: Color(0xFF7E8188),
                                    fontFamily: 'Montserrat',
                                    fontWeight: FontWeight.bold,
                                    fontSize: 14)),
                          ),
                          Spacer(),
                          Icon(
