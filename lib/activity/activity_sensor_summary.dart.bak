class SensorSummaryActivity extends StatefulWidget {
  final String? name;
  final String? imei;
  final String? from;

  const SensorSummaryActivity({Key? key, this.name, this.imei, this.from})
      : super(key: key);

  @override
  _SensorSummaryActivityState createState() =>
      _SensorSummaryActivityState(name!, imei!, from!);
}

class _SensorSummaryActivityState extends State<SensorSummaryActivity> {
  final String? name;
  final String? imei;
  final String? from;
  List<String> sensorList = [];
  String? dtf, dtt;
  String today = 'loading'.tr;
  String yesterday = 'loading'.tr;
  String week = 'loading'.tr;
  String month = 'loading'.tr;
  String result = 'GO';
  String zeroTime = '00:00:00';
  var formatter = new intl.DateFormat('yyyy-MM-dd');
  String sensorName = '';

  _SensorSummaryActivityState(this.name, this.imei, this.from);

  DropdownButton<String> androidSensorDropDown() {
    List<DropdownMenuItem<String>> dropdownItems = [];
    for (int i = 0; i < sensorList.length; i++) {
      var newItem = DropdownMenuItem(
        child: Text(sensorList[i]),
        value: sensorList[i],
      );
      dropdownItems.add(newItem);
    }

    return DropdownButton<String>(
      value: sensorName,
      items: dropdownItems,
      dropdownColor: Colors.white,
      onChanged: (value) {
        setState(() {
          sensorName = value!;
        });
        initData();
      },
    );
  }

  Future<String> fetchData(String dtf, String dtt) async {
    var response = await NetworkHelper().requestDataFromNetworkWithTimeout(
        urlFile: '/func/fn_reports.gen.php',
        body: {
          'cmd': 'report',
          'data_items': 'activation_time,deactivation_time',
          'dtf': dtf,
          'dtt': dtt,
          'format': 'html',
          'imei': '$imei',
          'name': '',
          'sensor_names': sensorName,
          'show_addresses': 'false',
          'show_coordinates': 'true',
          'speed_limit': '',
          'stop_duration': '300',
          'type': 'logic_sensors',
          'zone_ids': '',
          'zones_addresses': 'false',
          'app': 'true',
          'ignore_empty_reports':'',
          'markers_addresses':'false',
          'marker_ids':'',
          'other':''
        },
        context: context);
    if (response.isNotEmpty) {
      var responseDocument =
          await NetworkHelper().requestDataFromNetworkWithTimeout(
              urlFile: '/func/fn_saveas.php?format=html',
              body: {
                'filename': 'report',
                'content': response,
              },
              context: context);
      var document = parse(responseDocument);
      try {
        DateTime totalTime = DateTime(0000, 0, 1);
        for (int i = 1;
            i < document.body!.children[5].children[0].children.length;
            i++) {
          DateTime activationTime = DateTime.parse(document
              .body!.children[5].children[0].children[i].children[0].text);
          DateTime deactivationTime = DateTime.parse(document
              .body!.children[5].children[0].children[i].children[1].text);
          totalTime =
              totalTime.add(deactivationTime.difference(activationTime));
        }
        return '${(totalTime.day - 1) * 24 + totalTime.hour} H ${totalTime.minute} M ${totalTime.second} S';
      } catch (e) {
        return 'noDataItem'.tr;
      }
    } else {
      return 'noDataItem'.tr;
    }
  }

  @override
  void initState() {
    super.initState();
    /*FnSettingsModel dataSettingModel =
    FnSettingsModel.fromJson(jsonDecode(Globals.prefs.getString('${imei}_settings')));*/

    VehicleSettingsModel vehicleSettingsModel = VehicleSettingsModel.fromJson(
        jsonDecode(Globals.prefs!.getString('${imei}_settings')!));

    Map<String, Sensors> sensorsJsonObject = {};

    try {
      sensorsJsonObject.addAll(vehicleSettingsModel.sensors!);
    } catch (e) {}
    List<String> sensorsKeysJsonArray = [];
    if (sensorsJsonObject != null) {
      sensorsKeysJsonArray = sensorsJsonObject.keys.toList();
    }
    for (int j = 0; j < sensorsKeysJsonArray.length; j++) {
      String sensorID = sensorsKeysJsonArray[j];
      Sensors sensorJsonObject = sensorsJsonObject[sensorID]!;
      String sensorNameT = sensorJsonObject.name!;
      String sensorType = sensorJsonObject.resultType!;
      if (sensorType == 'logic') {
        sensorList.add(sensorNameT);
      }
    }
    sensorName = sensorList[0];

    dtf = '${formatter.format(DateTime.now())} $zeroTime';
    dtt =
        '${formatter.format(DateTime.now().add(Duration(days: 1)))} $zeroTime';
    initData();
  }

  void initData() async {
    today = 'loading'.tr;
    yesterday = 'loading'.tr;
    week = 'loading'.tr;
    month = 'loading'.tr;
    fetchData('${formatter.format(DateTime.now())} $zeroTime',
            '${formatter.format(DateTime.now().add(Duration(days: 1)))} $zeroTime')
        .then((value) {
      setState(() {
        today = '$value\n' + 'today'.tr;
      });
    });
    fetchData(
            '${formatter.format(DateTime.now().subtract(Duration(days: 1)))} $zeroTime',
            '${formatter.format(DateTime.now())} $zeroTime')
        .then((value) {
      setState(() {
        yesterday = '$value\n' + 'yesterday'.tr;
      });
    });
    fetchData(
            '${formatter.format(DateTime.now().subtract(Duration(days: 7)))} $zeroTime',
            '${formatter.format(DateTime.now())} $zeroTime')
        .then((value) {
      setState(() {
        week = '$value\n' + 'sevendays'.tr;
      });
    });
    fetchData(
            '${formatter.format(DateTime.now().subtract(Duration(days: 30)))} $zeroTime',
            '${formatter.format(DateTime.now())} $zeroTime')
        .then((value) {
      setState(() {
        month = '$value\n' + 'threezerodays'.tr;
      });
    });
  }

  resetResultTimer() {
    Timer(Duration(seconds: 5), () {
      setState(() {
        result = 'GO'.tr;
      });
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: Color(0xFFF6F6F6),
      appBar: AppBar(
        backgroundColor: Globals.appColor,
        elevation: 0.0,
        title: Text(
          'logicSensors'.tr,
          style:
              TextStyle(color: Color(0xFFF6F6F6), fontFamily: 'Baloo_Thambi_2'),
        ),
        iconTheme: IconThemeData(
          color: Color(0xFFF6F6F6), //change your color here
        ),
      ),
      body: SingleChildScrollView(
        child: Container(
