  void showNameDialog(String name, String imei, BuildContext context2) {
    final TextEditingController nameController = new TextEditingController();
    showGeneralDialog(
      barrierLabel: 'changeName'.tr,
      barrierDismissible: true,
      barrierColor: Colors.black.withOpacity(0.5),
      context: context,
      transitionDuration: Duration(milliseconds: 100),
      pageBuilder: (context, __, ___) {
        return Center(
          child: Padding(
            padding: const EdgeInsets.all(10.0),
            child: Container(
              color: Colors.white,
              padding: const EdgeInsets.all(10.0),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: <Widget>[
                  Text(
                    name,
                    maxLines: 1,
                    textAlign: TextAlign.end,
                    style: TextStyle(
                      color: Colors.black,
                      fontSize: 15,
                      decoration: TextDecoration.none,
                      letterSpacing: 1.0,
                      fontFamily: 'Montserrat',
                    ),
                  ),
                  Card(
                    elevation: 0,
                    child: TextField(
                      controller: nameController,
                      decoration: InputDecoration(
                        hintStyle: TextStyle(fontSize: 17),
                        hintText: 'nameError'.tr,
                        border: InputBorder.none,
                        contentPadding: EdgeInsets.all(20),
                      ),
                    ),
                  ),
                  CustomProgressButton(
                    stateColors: {
                      ButtonState.success: Colors.green,
                      ButtonState.fail: Colors.redAccent,
                      ButtonState.loading: Colors.red,
                      ButtonState.idle: Globals.appColor,
                    },
                    stateWidgets: {
                      ButtonState.success: Text(
                        'success'.tr,
                        style: TextStyle(fontSize: 20),
                      ),
                      ButtonState.fail: Text(
                        'failure'.tr,
                        style: TextStyle(fontSize: 20),
                      ),
                      ButtonState.loading: Text(
                        'changeName'.tr,
                        style: TextStyle(color: Colors.white, fontSize: 14),
                      ),
                      ButtonState.idle: Text(
                        'proceed'.tr,
                        style: TextStyle(fontSize: 20, color: Colors.white),
                      ),
                    },
                    onPressed: () async {
                      if (nameController.text.isNotEmpty) {
                        updateValueName(
                            imei, nameController.text, context, context2);
                        nameController.text = '';
                      } else {
                        ScaffoldMessenger.of(context).showSnackBar(SnackBar(
                            content: Text('Please enter device name.')));
                      }
                    },
                    height: MediaQuery.of(context).size.height * 0.06,
                    progressWidget: CircularProgressIndicator(
                        backgroundColor: Globals.appColor,
                        valueColor:
                            new AlwaysStoppedAnimation<Color>(Colors.white)),
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

  void showFuelDialog(
      String name, String imei, FCR fcr, BuildContext context2) {
    final TextEditingController fuelTxt = new TextEditingController();
    showGeneralDialog(
      barrierLabel: ('enterFuel').tr,
      barrierDismissible: true,
      barrierColor: Colors.black.withOpacity(0.5),
      context: context,
      transitionDuration: Duration(milliseconds: 100),
      pageBuilder: (context, __, ___) {
        return Center(
          child: Padding(
            padding: const EdgeInsets.all(10.0),
            child: Container(
              color: Colors.white,
              padding: const EdgeInsets.all(10.0),
              child: Column(
                mainAxisSize: MainAxisSize.min,
                children: <Widget>[
                  Text(
                    name,
                    maxLines: 1,
                    textAlign: TextAlign.end,
                    style: TextStyle(
                      color: Colors.black,
                      fontSize: 15,
                      decoration: TextDecoration.none,
                      letterSpacing: 1.0,
                      fontFamily: 'Montserrat',
                    ),
                  ),
                  Card(
                    elevation: 0,
                    child: TextField(
                      controller: fuelTxt,
                      keyboardType: TextInputType.number,
                      decoration: InputDecoration(
                        hintStyle: TextStyle(fontSize: 17),
                        hintText: ('enterFuel').tr,
                        border: InputBorder.none,
                        contentPadding: EdgeInsets.all(20),
                      ),
                    ),
                  ),
                  CustomProgressButton(
                    onPressed: () async {
                      if (fuelTxt.text.isNotEmpty) {
                        updateFuelCost(
                            imei,
                            jsonEncode(FCR(
                                    source: fcr.source,
                                    measurement: fcr.measurement,
                                    cost: fuelTxt.text,
                                    summer: fcr.summer,
                                    winter: fcr.winter,
                                    winterStart: fcr.winterStart,
                                    winterEnd: fcr.winterEnd)
                                .toJson()),
                            context,
                            context2);
                        fuelTxt.text = '';
                      } else {
                        ScaffoldMessenger.of(context).showSnackBar(
                            SnackBar(content: Text('pleaseEnterFuelCost'.tr)));
                      }
                    },
                    stateWidgets: {
                      ButtonState.success: Text(
                        'success'.tr,
                        style: TextStyle(fontSize: 20),
                      ),
                      ButtonState.fail: Text(
                        'failure'.tr,
                        style: TextStyle(fontSize: 20),
                      ),
                      ButtonState.loading: Text(
                        'changeName'.tr,
                        style: TextStyle(color: Colors.white, fontSize: 14),
                      ),
                      ButtonState.idle: Text(
                        'proceed'.tr,
                        style: TextStyle(fontSize: 20, color: Colors.white),
                      ),
                    },
                    // us
                    height: MediaQuery.of(context).size.height * 0.06,
                    maxWidth: MediaQuery.of(context).size.width * 0.50,
                    progressWidget: CircularProgressIndicator(
                        backgroundColor: Globals.appColor,
                        valueColor:
                            new AlwaysStoppedAnimation<Color>(Colors.white)),
                    stateColors: {
                      ButtonState.success: Colors.green,
                      ButtonState.fail: Colors.redAccent,
                      ButtonState.loading: Colors.red,
                      ButtonState.idle: Globals.appColor,
                    },
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

