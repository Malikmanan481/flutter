  void updateFuelCost(String imei, String value, BuildContext context,
      BuildContext context2) async {
    ProgressDialog pr;
    pr = new ProgressDialog(context,
        type: ProgressDialogType.normal, isDismissible: false, showLogs: false);
    pr.show();
    var response = await NetworkHelper().requestDataFromNetworkWithTimeout(
        urlFile: 'func/fn_settings.objects.php',
        body: {
          'cmd': 'edit_object',
          'fcr': value,
          'group_id': fnSettingString!.groupID,
          'driver_id': fnSettingString!.driverID,
          'trailer_id': fnSettingString!.trailerID,
          'name': fnSettingString!.name,
          'imei': imei,
          'device': fnSettingString!.device,
          'sim_number': fnSettingString!.simNumber,
          'model': fnSettingString!.model,
          'vin': fnSettingString!.vin,
          'plate_number': fnSettingString!.plateNumber,
          'map_arrows': fnSettingString!.mapArrow,
          'map_icon': fnSettingString!.mapIcon,
          'tail_color': fnSettingString!.tailColor,
          'tail_points': fnSettingString!.tailPoints,
          'time_adj': fnSettingString!.timeAdj,
          'accuracy': fnSettingString!.accuracy,
          'unassign_driver': 'false',
          'accvirt': fnSettingString!.false1,
          'accvirt_cn': fnSettingString!.false2,
          'forward_loc_data': "false",
          'forward_loc_data_imei': "false",
          'odometer_type': fnSettingString!.odometerType,
          'engine_hours_type': fnSettingString!.engineHourType,
          'odometer': fnSettingString!.odometer,
          'engine_hours': fnSettingString!.engineHours,
          'icon': fnSettingString!.icon
        },
        context: context);
    if (response.isNotEmpty) {
      if (response.toLowerCase() == 'ok') {
        Fluttertoast.showToast(
            msg:
                'Details changed successfully. App will restart automatically!!',
            toastLength: Toast.LENGTH_SHORT,
            gravity: ToastGravity.CENTER,
            timeInSecForIosWeb: 1,
            backgroundColor: Globals.appColor,
            textColor: Colors.white,
            fontSize: 16.0);
        Navigator.pop(context);
        Navigator.pop(context2);
        Timer(Duration(seconds: 2), () {
          Get.to(
              transition: Transition.rightToLeft,
              SplashScreen(isFromLogin: false, isAppRestarted: true));
        });
      } else {
        Fluttertoast.showToast(
            msg: 'contactSupport'.tr,
            toastLength: Toast.LENGTH_SHORT,
            gravity: ToastGravity.CENTER,
            timeInSecForIosWeb: 1,
            backgroundColor: Globals.appColor,
            textColor: Colors.white,
            fontSize: 16.0);
      }
    } else {
      Fluttertoast.showToast(
          msg: 'contactSupport'.tr,
          toastLength: Toast.LENGTH_SHORT,
          gravity: ToastGravity.CENTER,
          timeInSecForIosWeb: 1,
          backgroundColor: Globals.appColor,
          textColor: Colors.white,
          fontSize: 16.0);
    }
    pr.hide();
  }

