class ChangeIconActivity extends StatefulWidget {
  @override
  _ChangeIconActivityState createState() => _ChangeIconActivityState();
}

class _ChangeIconActivityState extends State<ChangeIconActivity> {
  List<String> imeiArray = [];
  List<String> namesJsonArray = [];
  List<String> imagesJsonArray = [];
  //FCR Comment OUT
  List<FCR> fcrJsonArray = [];

  VehicleSettingsModel? fnSettingString;
  BuildContext? _context;
  @override
  void initState() {
    super.initState();
    fetchData();
  }

  void fetchData() {
    imeiArray.clear();
    namesJsonArray.clear();
    imagesJsonArray.clear();
    try {
      imeiArray.addAll(Globals.prefs!.getStringList(MainPrefs.keyIMEI)!);
      for (int i = 0; i < imeiArray.length; i++) {
        fnSettingString = VehicleSettingsModel.fromJson(
            jsonDecode(Globals.prefs!.getString('${imeiArray[i]}_settings')!));
        print("-------------------------");
        print(Globals.prefs!.getString('${imeiArray[i]}_settings')!);
        /*TestingSettingsModel vehicleSettingsModel = TestingSettingsModel.fromJson(
          jsonDecode(Globals.prefs.getString('${imeiArray[i]}_settings')));*/
        namesJsonArray.add(fnSettingString!.name!);
        fcrJsonArray.add(fnSettingString!.fcr!);
        imagesJsonArray.add(
            'images/${Globals.prefs!.getString('${imeiArray[i]}_icons')}red.png');
      }
      setState(() {});
    } catch (e) {}
  }

