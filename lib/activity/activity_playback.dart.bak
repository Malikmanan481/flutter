class PlaybackActivity extends StatefulWidget {
  final String? name;
  final String? imei;
  final String? lat;
  final String? lng;
  final String? angle;
  final String? status;
  final int? speed;

  const PlaybackActivity(
      {Key? key,
      this.name,
      this.imei,
      this.lat,
      this.lng,
      this.angle,
      this.status,
      this.speed})
      : super(key: key);

  @override
  _PlaybackActivityState createState() =>
      _PlaybackActivityState(name!, imei!, lat!, lng!, angle!, status!, speed!);
}

class _PlaybackActivityState extends State<PlaybackActivity> {
  final String? name;
  final String? imei;
  final String? lat;
  Map<MarkerId, Marker> markers = <MarkerId, Marker>{};
  final String? lng;
  final String? angle;
  final String? status;
  final int? speed;

  List<String> stopsList = [
    '> 1 min',
    '> 2 min',
    '> 5 min',
    '> 10 min',
    '> 20 min',
    '> 30 min',
    '> 1 hr',
    '> 2 hr',
    '> 5 hr'
  ];
  List<String> preTimeList = [
    'lasthour'.tr,
    'today'.tr,
    'yesterday'.tr,
    'before2days'.tr,
    'before3days'.tr,
    'thisweek'.tr,
    'lastweek'.tr,
    'thismonth'.tr,
    'lastmonth'.tr
  ];
  int indexTime = 1;
  String reportStopDefault = '> 1 min';
  String reportPreTimeDefault = 'today'.tr;
  String? dtf, dtt;
  String buttonText = 'playback'.tr;

  _PlaybackActivityState(this.name, this.imei, this.lat, this.lng, this.angle,
      this.status, this.speed);

  differentTimes() {
    String zeroTime = '00:00:00';
    var formatterForHour = new DateFormat('yyyy-MM-dd HH:mm:ss');
    var formatter = new DateFormat('yyyy-MM-dd');
    switch (indexTime) {
      case 0:
        dtf = formatterForHour
            .format(DateTime.now().subtract(Duration(hours: 1)));
        dtt = formatterForHour.format(DateTime.now());
        break;
      case 1:
        dtf = '${formatter.format(DateTime.now())} $zeroTime';
        dtt =
            '${formatter.format(DateTime.now().add(Duration(days: 1)))} $zeroTime';
        break;
      case 2:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: 1)))} $zeroTime';
        dtt = '${formatter.format(DateTime.now())} $zeroTime';
        break;
      case 3:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: 2)))} $zeroTime';
        dtt = '${formatter.format(DateTime.now())} $zeroTime';
        break;
      case 4:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: 3)))} $zeroTime';
        dtt = '${formatter.format(DateTime.now())} $zeroTime';
        break;
      case 5:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: 7)))} $zeroTime';
        dtt = '${formatter.format(DateTime.now())} $zeroTime';
        break;
      case 6:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: 14)))} $zeroTime';
        dtt =
            '${formatter.format(DateTime.now().subtract(Duration(days: 7)))} $zeroTime';
        break;
      case 7:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: DateTime.now().day - 1)))} $zeroTime';
        dtt = '${formatter.format(DateTime.now())} $zeroTime';
        break;
      case 8:
        dtf =
            '${formatter.format(DateTime.now().subtract(Duration(days: DateTime.now().day + (daysInMonth(DateTime.now().subtract(Duration(days: DateTime.now().day))) - 1))))} $zeroTime';
        dtt =
            '${formatter.format(DateTime.now().subtract(Duration(days: DateTime.now().day)))} $zeroTime';
        break;
    }
    setState(() {});
  }

  int daysInMonth(DateTime date) {
    var firstDayThisMonth = new DateTime(date.year, date.month, date.day);
    var firstDayNextMonth = new DateTime(firstDayThisMonth.year,
        firstDayThisMonth.month + 1, firstDayThisMonth.day);
    return firstDayNextMonth.difference(firstDayThisMonth).inDays;
  }

  DropdownButton<String> androidStopDropdown() {
    List<DropdownMenuItem<String>> dropdownItems = [];
    for (int i = 0; i < stopsList.length; i++) {
      var newItem = DropdownMenuItem(
        child: Text(stopsList[i]),
        value: stopsList[i],
      );
      dropdownItems.add(newItem);
    }

    return DropdownButton<String>(
      value: reportStopDefault,
      dropdownColor: Colors.white,
      items: dropdownItems,
      onChanged: (value) {
        setState(() {
          reportStopDefault = value!;
        });
      },
    );
  }

  DropdownButton<String> androidPreTimeDropdown() {
    List<DropdownMenuItem<String>> dropdownItems = [];
    for (int i = 0; i < preTimeList.length; i++) {
      var newItem = DropdownMenuItem(
        child: Text(preTimeList[i]),
        value: preTimeList[i],
      );
      dropdownItems.add(newItem);
    }

    return DropdownButton<String>(
      value: reportPreTimeDefault,
      items: dropdownItems,
      dropdownColor: Colors.white,
      onChanged: (value) {
        indexTime = preTimeList.indexOf(value!);
        differentTimes();
        setState(() {
          reportPreTimeDefault = value;
        });
      },
    );
  }

  void setMarker() async {
    BitmapDescriptor bitmapDescriptor = await Helper().getMarker(
        context,
        status!,
        name!,
        '0',
        speed!,
        'images/'
            '${Helper().getMarkerName(status!, Globals.prefs!.getString('${imei}_icons')!)}');
    final MarkerId markerId = MarkerId(imei!);
    markers.removeWhere((key, value) => key == markerId);
    try {
      setState(() {
        markers[markerId] = Marker(
          position: LatLng(double.parse(lat!), double.parse(lng!)),
          icon: bitmapDescriptor,
          anchor: Offset(9, 0.675),
          markerId: markerId,
        );
      });
    } catch (e) {}
  }

  @override
  void dispose() {
    SystemChrome.setSystemUIOverlayStyle(SystemUiOverlayStyle(
      statusBarColor: Globals.appColor,
      statusBarBrightness: Brightness.dark,
      statusBarIconBrightness: Brightness.light,
      systemNavigationBarColor: Globals.appColor,
    ));
    super.dispose();
  }

  @override
  void initState() {
    super.initState();

    differentTimes();
  }

