class Trip {
  final String? start, end, duration;
  final dynamic length;
  final int? topSpeed, avgSpeed;
  final List<LatLng>? routePoints;
  final LatLng? southWest, northeast;

  Trip(
      {this.duration,
      this.southWest,
      this.northeast,
      this.topSpeed,
      this.avgSpeed,
      this.end,
      this.routePoints,
      this.length,
      this.start});
}
