                GoogleMap(
                    onTap: (value) {
                      setState(() {
                        viewHider = !viewHider;
                      });
                    },
                    compassEnabled: false,
                    initialCameraPosition: CameraPosition(
                      zoom: 18,
                      target: LatLng(
                          double.parse(finalLat!), double.parse(finalLng!)),
