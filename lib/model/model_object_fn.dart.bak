class D {
  final String date;
  final String time;
  final String latitude;
  final String longitude;
  final String zero1;
  final String zero2;
  final int zero3;
  final InnerData innerData;

  D({
    this.date,
    this.time,
    this.latitude,
    this.longitude,
    this.zero1,
    this.zero2,
    this.zero3,
    this.innerData,
  });

  factory D.fromJson(List<dynamic> json) {
    return D(
      date: json[0] ?? '',
      time: json[1] ?? '',
      latitude: json[2] ?? '',
      longitude: json[3] ?? '',
      zero1: json[4] ?? '',
      zero2: json[5] ?? '',
      zero3: json[6] ?? 0,
      innerData: json[7] != null ? InnerData.fromJson(Map<String, dynamic>.from(json[7])) : null);
  }

  List<dynamic> toJson() {
    return [
      date,
      time,
      latitude,
      longitude,
      zero1,
      zero2,
      zero3,
      innerData?.toJson(), // assuming InnerData has a toJson method
    ];
  }

}
