class ObjectDataModel {
  dynamic v;
  dynamic f;
  dynamic s;
  dynamic evt;
  dynamic evtac;
  dynamic evtohc;
  dynamic a;
  List<dynamic>? l;
  List<List<dynamic>>? d;
  dynamic lif;
  dynamic st;
  dynamic ststr;
  dynamic p;
  dynamic cn;
  dynamic o;
  dynamic eh;
  List<dynamic>? sr;

  ObjectDataModel({
    this.v,
    this.f,
    this.s,
    this.evt,
    this.evtac,
    this.evtohc,
    this.a,
    this.l,
    this.d,
    this.lif,
    this.st,
    this.ststr,
    this.p,
    this.cn,
    this.o,
    this.eh,
    this.sr,
  });

  factory ObjectDataModel.fromJson(Map<String, dynamic> json) => ObjectDataModel(
        v: json["v"],
        f: json["f"],
        s: json["s"],
        evt: json["evt"],
        evtac: json["evtac"],
        evtohc: json["evtohc"],
        a: json["a"],
        l: List<dynamic>.from(json["l"].map((x) => x)),
        d: List<List<dynamic>>.from(json["d"].map((x) => List<dynamic>.from(x.map((x) => x)))),
        lif: json['lif'],
        st: json["st"],
        ststr: json["ststr"],
        p: json["p"],
        cn: json["cn"],
        o: json["o"],
        eh: json["eh"],
        sr: List<dynamic>.from(json["sr"].map((x) => x)),
      );

  Map<String, dynamic> toJson() => {
        "v": v,
        "f": f,
        "s": s,
        "evt": evt,
        "evtac": evtac,
        "evtohc": evtohc,
        "a": a,
        "l": List<dynamic>.from(l!.map((x) => x)),
        "d": List<dynamic>.from(d!.map((x) => List<dynamic>.from(x.map((x) => x)))),
        "lif": lif,
        "st": st,
        "ststr": ststr,
        "p": p,
        "cn": cn,
        "o": o,
        "eh": eh,
        "sr": List<dynamic>.from(sr!.map((x) => x)),
      };
}
