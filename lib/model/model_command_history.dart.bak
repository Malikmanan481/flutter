class CommandHistory {
  CommandHistory({
    this.page,
    this.records,
    this.rows,
  });

  int? page;
  int? records;
  List<Row>? rows;

  factory CommandHistory.fromJson(Map<String, dynamic> json) => CommandHistory(
        page: json["page"],
        records: json["records"],
        rows: List<Row>.from(json["rows"].map((x) => Row.fromJson(x))),
      );

  Map<String, dynamic> toJson() => {
        "page": page,
        "records": records,
        "rows": List<dynamic>.from(rows!.map((x) => x.toJson())),
      };
}

class Row {
  Row({
    this.id,
    this.cell,
  });

  String? id;
  List<String>? cell;

  factory Row.fromJson(Map<String, dynamic> json) => Row(
        id: json["id"],
        cell: List<String>.from(json["cell"].map((x) => x)),
      );

  Map<String, dynamic> toJson() => {
        "id": id,
        "cell": List<dynamic>.from(cell!.map((x) => x)),
      };
}
