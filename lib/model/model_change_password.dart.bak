class ChangePassword {
  ChangePassword({
    this.username,
    this.email,
    this.managerId,
    this.cpanelPrivileges,
    this.privileges,
    this.privilegesImei,
    this.privilegesMarker,
    this.privilegesRoute,
    this.privilegesZone,
    this.privilegesDashboard,
    this.privilegesHistory,
    this.privilegesReports,
    this.privilegesTasks,
    this.privilegesRilogbook,
    this.privilegesDtc,
    this.privilegesMaintenance,
    this.privilegesExpenses,
    this.privilegesObjectControl,
    this.privilegesImageGallery,
    this.privilegesChat,
    this.privilegesSubaccounts,
    this.billing,
    this.objAdd,
    this.objLimit,
    this.objLimitNum,
    this.objDays,
    this.objDaysDt,
    this.objEdit,
    this.objDelete,
    this.objHistoryClear,
    this.chatNotify,
    this.dashboard,
    this.mapSp,
    this.mapIs,
    this.mapRc,
    this.mapRhc,
    this.mapOcp,
    this.groupsCollapsed,
    this.od,
    this.ohc,
    this.datalist,
    this.datalistItems,
    this.pushNotifyDesktop,
    this.pushNotifyMobile,
    this.pushNotifyMobileInterval,
    this.smsGateway,
    this.smsGatewayType,
    this.smsGatewayUrl,
    this.smsGatewayIdentifier,
    this.smsGatewayTotalInQueue,
    this.startupTab,
    this.language,
    this.unitDistance,
    this.unitCapacity,
    this.unitTemperature,
    this.currency,
    this.timezone,
    this.dst,
    this.dstStart,
    this.dstEnd,
    this.info,
    this.usageEmailDaily,
    this.usageSmsDaily,
    this.usageApiDaily,
    this.usageEmailDailyCnt,
    this.usageSmsDailyCnt,
    this.usageApiDailyCnt,
  });


  dynamic username;
  dynamic email;
  dynamic managerId;
  dynamic cpanelPrivileges;
  dynamic privileges;
  dynamic privilegesImei;
  dynamic privilegesMarker;
  dynamic privilegesRoute;
  dynamic privilegesZone;
  dynamic privilegesDashboard;
  dynamic privilegesHistory;
  dynamic privilegesReports;
  dynamic privilegesTasks;
  dynamic privilegesRilogbook;
  dynamic privilegesDtc;
  dynamic privilegesMaintenance;
  dynamic privilegesExpenses;
  dynamic privilegesObjectControl;
  dynamic privilegesImageGallery;
  dynamic privilegesChat;
  dynamic privilegesSubaccounts;
  dynamic billing;
  dynamic objAdd;
  dynamic objLimit;
  dynamic objLimitNum;
  dynamic objDays;
  dynamic objDaysDt;
  dynamic objEdit;
  dynamic objDelete;
  dynamic objHistoryClear;
  dynamic chatNotify;
  Dashboard? dashboard;
  dynamic mapSp;
  dynamic mapIs;
  dynamic mapRc;
  dynamic mapRhc;
  dynamic mapOcp;
  GroupsCollapsed? groupsCollapsed;
  dynamic od;
  Ohc? ohc;
  dynamic datalist;
  dynamic datalistItems;
  dynamic pushNotifyDesktop;
  dynamic pushNotifyMobile;
  dynamic pushNotifyMobileInterval;
  dynamic smsGateway;
  dynamic smsGatewayType;
  dynamic smsGatewayUrl;
  dynamic smsGatewayIdentifier;
  int? smsGatewayTotalInQueue;
  dynamic startupTab;
  dynamic language;
  dynamic unitDistance;
  dynamic unitCapacity;
  dynamic unitTemperature;
  dynamic currency;
  dynamic timezone;
  dynamic dst;
  dynamic dstStart;
  dynamic dstEnd;
  Info? info;
  dynamic usageEmailDaily;
  dynamic usageSmsDaily;
  dynamic usageApiDaily;
  dynamic usageEmailDailyCnt;
  dynamic usageSmsDailyCnt;
  dynamic usageApiDailyCnt;

  factory ChangePassword.fromJson(Map<dynamic, dynamic> json) => ChangePassword(
        username: json["username"],
        email: json["email"],
        managerId: json["manager_id"],
        cpanelPrivileges: json["cpanel_privileges"] == 'true',
        privileges: json["privileges"],
        privilegesImei: json["privileges_imei"],
        privilegesMarker: json["privileges_marker"],
        privilegesRoute: json["privileges_route"],
        privilegesZone: json["privileges_zone"],
        privilegesDashboard: json["privileges_dashboard"],
        privilegesHistory: json["privileges_history"],
        privilegesReports: json["privileges_reports"],
        privilegesTasks: json["privileges_tasks"],
        privilegesRilogbook: json["privileges_rilogbook"],
        privilegesDtc: json["privileges_dtc"],
        privilegesMaintenance: json["privileges_maintenance"],
        privilegesExpenses: json["privileges_expenses"],
        privilegesObjectControl: json["privileges_object_control"],
        privilegesImageGallery: json["privileges_image_gallery"],
        privilegesChat: json["privileges_chat"],
        privilegesSubaccounts: json["privileges_subaccounts"],
        billing: json["billing"],
        objAdd: json["obj_add"],
        objLimit: json["obj_limit"],
        objLimitNum: json["obj_limit_num"],
        objDays: json["obj_days"],
        objDaysDt: json["obj_days_dt"],
        objEdit: json["obj_edit"],
        objDelete: json["obj_delete"],
        objHistoryClear: json["obj_history_clear"],
        chatNotify: json["chat_notify"],
        dashboard: Dashboard.fromJson(json["dashboard"]),
        mapSp: json["map_sp"],
        mapIs: json["map_is"],
        mapRc: json["map_rc"],
        mapRhc: json["map_rhc"],
        mapOcp: json["map_ocp"],
        groupsCollapsed: GroupsCollapsed.fromJson(json["groups_collapsed"]),
        od: json["od"],
        ohc: Ohc.fromJson(json["ohc"]),
        datalist: json["datalist"],
        datalistItems: json["datalist_items"],
        pushNotifyDesktop: json["push_notify_desktop"],
        pushNotifyMobile: json["push_notify_mobile"],
        pushNotifyMobileInterval: json["push_notify_mobile_interval"],
        smsGateway: json["sms_gateway"],
        smsGatewayType: json["sms_gateway_type"],
        smsGatewayUrl: json["sms_gateway_url"],
        smsGatewayIdentifier: json["sms_gateway_identifier"],
        smsGatewayTotalInQueue: json["sms_gateway_total_in_queue"],
        startupTab: json["startup_tab"],
        language: json["language"],
        unitDistance: json["unit_distance"],
        unitCapacity: json["unit_capacity"],
        unitTemperature: json["unit_temperature"],
        currency: json["currency"],
        timezone: json["timezone"],
        dst: json["dst"],
        dstStart: json["dst_start"],
        dstEnd: json["dst_end"],
        info: Info.fromJson(json["info"]),
        usageEmailDaily: json["usage_email_daily"],
        usageSmsDaily: json["usage_sms_daily"],
        usageApiDaily: json["usage_api_daily"],
        usageEmailDailyCnt: json["usage_email_daily_cnt"],
        usageSmsDailyCnt: json["usage_sms_daily_cnt"],
        usageApiDailyCnt: json["usage_api_daily_cnt"],
      );

  Map<dynamic, dynamic> toJson() => {
        "username": username,
        "email": email,
        "manager_id": managerId,
        "cpanel_privileges": cpanelPrivileges,
        "privileges": privileges,
        "privileges_imei": privilegesImei,
        "privileges_marker": privilegesMarker,
        "privileges_route": privilegesRoute,
        "privileges_zone": privilegesZone,
        "privileges_dashboard": privilegesDashboard,
        "privileges_history": privilegesHistory,
        "privileges_reports": privilegesReports,
        "privileges_tasks": privilegesTasks,
        "privileges_rilogbook": privilegesRilogbook,
        "privileges_dtc": privilegesDtc,
        "privileges_maintenance": privilegesMaintenance,
        "privileges_expenses": privilegesExpenses,
        "privileges_object_control": privilegesObjectControl,
        "privileges_image_gallery": privilegesImageGallery,
        "privileges_chat": privilegesChat,
        "privileges_subaccounts": privilegesSubaccounts,
        "billing": billing,
        "obj_add": objAdd,
        "obj_limit": objLimit,
        "obj_limit_num": objLimitNum,
        "obj_days": objDays,
        "obj_days_dt": objDaysDt,
        "obj_edit": objEdit,
        "obj_delete": objDelete,
        "obj_history_clear": objHistoryClear,
        "chat_notify": chatNotify,
        "dashboard": dashboard!.toJson(),
        "map_sp": mapSp,
        "map_is": mapIs,
        "map_rc": mapRc,
        "map_rhc": mapRhc,
        "map_ocp": mapOcp,
        "groups_collapsed": groupsCollapsed!.toJson(),
        "od": od,
        "ohc": ohc!.toJson(),
        "datalist": datalist,
        "datalist_items": datalistItems,
        "push_notify_desktop": pushNotifyDesktop,
        "push_notify_mobile": pushNotifyMobile,
        "push_notify_mobile_interval": pushNotifyMobileInterval,
        "sms_gateway": smsGateway,
        "sms_gateway_type": smsGatewayType,
        "sms_gateway_url": smsGatewayUrl,
        "sms_gateway_identifier": smsGatewayIdentifier,
        "sms_gateway_total_in_queue": smsGatewayTotalInQueue,
        "startup_tab": startupTab,
        "language": language,
        "unit_distance": unitDistance,
        "unit_capacity": unitCapacity,
        "unit_temperature": unitTemperature,
        "currency": currency,
        "timezone": timezone,
        "dst": dst,
        "dst_start": dstStart,
        "dst_end": dstEnd,
        "info": info!.toJson(),
        "usage_email_daily": usageEmailDaily,
        "usage_sms_daily": usageSmsDaily,
        "usage_api_daily": usageApiDaily,
        "usage_email_daily_cnt": usageEmailDailyCnt,
        "usage_sms_daily_cnt": usageSmsDailyCnt,
        "usage_api_daily_cnt": usageApiDailyCnt,
      };
}

class Dashboard {
  Dashboard({
    this.openAfterLogin,
  });

  dynamic openAfterLogin;

  factory Dashboard.fromJson(Map<dynamic, dynamic> json) => Dashboard(
        openAfterLogin: json["open_after_login"],
      );

  Map<dynamic, dynamic> toJson() => {
        "open_after_login": openAfterLogin,
      };
}

class GroupsCollapsed {
  GroupsCollapsed({
    this.objects,
    this.markers,
    this.routes,
    this.zones,
  });

  dynamic objects;
  dynamic markers;
  dynamic routes;
  dynamic zones;

  factory GroupsCollapsed.fromJson(Map<dynamic, dynamic> json) => GroupsCollapsed(
        objects: json["objects"],
        markers: json["markers"],
        routes: json["routes"],
        zones: json["zones"],
      );

  Map<dynamic, dynamic> toJson() => {
        "objects": objects,
        "markers": markers,
        "routes": routes,
        "zones": zones,
      };
}

class Info {
  Info({
    this.name,
    this.company,
    this.address,
    this.postCode,
    this.city,
    this.country,
    this.phone1,
    this.phone2,
    this.email,
  });

  dynamic name;
  dynamic company;
  dynamic address;
  dynamic postCode;
  dynamic city;
  dynamic country;
  dynamic phone1;
  dynamic phone2;
  dynamic email;

  factory Info.fromJson(Map<dynamic, dynamic> json) => Info(
        name: json["name"],
        company: json["company"],
        address: json["address"],
        postCode: json["post_code"],
        city: json["city"],
        country: json["country"],
        phone1: json["phone1"],
        phone2: json["phone2"],
        email: json["email"],
      );

  Map<dynamic, dynamic> toJson() => {
        "name": name,
        "company": company,
        "address": address,
        "post_code": postCode,
        "city": city,
        "country": country,
        "phone1": phone1,
        "phone2": phone2,
        "email": email,
      };
}

class Ohc {
  Ohc({
    this.noConnection,
    this.noConnectionColor,
    this.stopped,
    this.stoppedColor,
    this.moving,
    this.movingColor,
    this.engineIdle,
    this.engineIdleColor,
    this.eventSos,
    this.eventSosColor,
  });

  dynamic noConnection;
  dynamic noConnectionColor;
  dynamic stopped;
  dynamic stoppedColor;
  dynamic moving;
  dynamic movingColor;
  dynamic engineIdle;
  dynamic engineIdleColor;
  dynamic eventSos;
  dynamic eventSosColor;

  factory Ohc.fromJson(Map<dynamic, dynamic> json) => Ohc(
        noConnection: json["no_connection"],
        noConnectionColor: json["no_connection_color"],
        stopped: json["stopped"],
        stoppedColor: json["stopped_color"],
        moving: json["moving"],
        movingColor: json["moving_color"],
        engineIdle: json["engine_idle"],
        engineIdleColor: json["engine_idle_color"],
        eventSos: json["event_sos"],
        eventSosColor: json["event_sos_color"],
      );

  Map<dynamic, dynamic> toJson() => {
        "no_connection": noConnection,
        "no_connection_color": noConnectionColor,
        "stopped": stopped,
        "stopped_color": stoppedColor,
        "moving": moving,
        "moving_color": movingColor,
        "engine_idle": engineIdle,
        "engine_idle_color": engineIdleColor,
        "event_sos": eventSos,
        "event_sos_color": eventSosColor,
      };
}
