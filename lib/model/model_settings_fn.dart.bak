class VehicleSettingsModel {
/*  String protocol;
  String groupID;
  String driverID;
  String trailerID;
  String name;
  String icon;
  MapArrow mapArrow;
  String mapIcon;
  String tailColor;
  String tailPoints;
  String device;
  String simNumber;
  String model;
  String vin;
  String plateNumber;
  String odometerType;
  String engineHourType;
  String odometer;
  String engineHours;
  FCR fcr;
  String timeAdj;
  Accuracy accuracy;
  Map<String, Sensors> sensors;
  Map<String, Service> service;
  Map<String, CustomFields> customFields;
  List<dynamic> params;
  bool active;
  bool objectExpire;
  String objectExpireDate;*/
  String? protocol;
  String? groupID;
  String? driverID;
  String? trailerID;
  String? name;
  String? icon;
  MapArrow? mapArrow;
  String? mapIcon;
  String? tailColor;
  String? tailPoints;
  String? device;
  String? simNumber;
  String? model;
  String? vin;
  String? plateNumber;
  String? odometerType;
  String? engineHourType;
  int? odometer;
  int? engineHours;
  FCR? fcr;
  String? timeAdj;
  Accuracy? accuracy;
  String? false1;
  String? false2;
  ParamAccvirt? paramAccvirt;
  String? false3;
  String? emptyString;
  Map<String, Sensors>? sensors;
  List<dynamic>? emptyList;
  dynamic emptyList1;
  List<dynamic>? stringVariable;
  bool? active;
  bool? objectExpire;
  String? objectExpireDate;

  List<dynamic> toJson() => [
        protocol,
        groupID,
        driverID,
        trailerID,
        name,
        icon,
        mapArrow,
        mapIcon,
        tailColor,
        tailPoints,
        device,
        simNumber,
        model,
        vin,
        plateNumber,
        odometerType,
        engineHourType,
        odometer,
        engineHours,
        fcr,
        timeAdj,
        accuracy,
        false1,
        false2,
        paramAccvirt,
        false3,
        emptyString,
        sensors,
        emptyList,
        emptyList1,
        stringVariable,
        active,
        objectExpire,
        objectExpireDate,
      ];

  VehicleSettingsModel.fromJson(List<dynamic> json)
      : protocol = json[0] ?? '',
        groupID = json[1] ?? '',
        driverID = json[2] ?? '',
        trailerID = json[3] ?? '',
        name = json[4] ?? '',
        icon = json[5] ?? '',
        mapArrow = MapArrow.fromJson(json[6] ?? {}),
        mapIcon = json[7] ?? '',
        tailColor = json[8] ?? '',
        tailPoints = json[9] ?? '',
        device = json[10] ?? '',
        simNumber = json[11] ?? '',
        model = json[12] ?? '',
        vin = json[13] ?? '',
        plateNumber = json[14] ?? '',
        odometerType = json[15] ?? '',
        engineHourType = json[16] ?? '',
        odometer = json[17] ?? '',
        engineHours = json[18] ?? '',
        fcr = FCR.fromJson(json[19] ?? {}),
        timeAdj = json[20] ?? '',
        accuracy = Accuracy.fromJson(json[21] ?? {}),
        false1 = json[22] ?? 'false',
        false2 = json[23] ?? 'false',
        paramAccvirt = ParamAccvirt.fromJson(json[24] ?? {}),
        false3 = json[25] ?? 'false',
        emptyString = json[26] ?? '',
        sensors = (json[27] is List && (json[27] as List).isEmpty)
            ? {}
            : (json[27] as Map<String, dynamic>?)?.map(
                    (key, value) => MapEntry(key, Sensors.fromJson(value))) ??
                {},
        emptyList = json[28] ?? [],
        emptyList1 = json[29],
        stringVariable = json[30] ?? [],
        active = json[31] == 'false' ? false : true,
        objectExpire = json[32] == 'false' ? false : true,
        objectExpireDate = json[33] ?? '';

  static String parseDate(dynamic date) {
    if (date == null || date.toString().isEmpty) {
      return '0000-00-00';
    }
    try {
      DateTime parsedDate = DateTime.parse(date.toString());
      return parsedDate.toIso8601String();
    } catch (e) {
      return '0000-00-00';
    }
  }

  VehicleSettingsModel(
    this.protocol,
    this.groupID,
    this.driverID,
    this.trailerID,
    this.name,
    this.icon,
    this.mapArrow,
    this.mapIcon,
    this.tailColor,
    this.tailPoints,
    this.device,
    this.simNumber,
    this.model,
    this.vin,
    this.plateNumber,
    this.odometerType,
    this.engineHourType,
    this.odometer,
    this.engineHours,
    this.fcr,
    this.timeAdj,
    this.accuracy,
    this.false1,
    this.false2,
    this.paramAccvirt,
    this.false3,
    this.emptyString,
    this.sensors,
    this.emptyList,
    this.emptyList1,
    this.stringVariable,
    this.active,
    this.objectExpire,
    this.objectExpireDate,
  );
}

class StringVariable {
  String? acc;
  String? batteryLevel;
  String? distance;
  String? ignition;
  String? motion;
  String? rssi;
  String? sat;
  String? status;
  String? totalDistance;

  StringVariable(
      {this.acc,
      this.batteryLevel,
      this.distance,
      this.ignition,
      this.motion,
      this.rssi,
      this.sat,
      this.status,
      this.totalDistance});

  factory StringVariable.fromJson(Map<String, dynamic> json) {
    return StringVariable(
      acc: json['acc'],
      batteryLevel: json['batteryLevel'],
      distance: json['distance'],
      ignition: json['ignition'],
      motion: json['motion'],
      rssi: json['rssi'],
      sat: json['sat'],
      status: json['status'],
      totalDistance: json['totalDistance'],
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'acc': acc,
      'batteryLevel': batteryLevel,
      'distance': distance,
      'ignition': ignition,
      'motion': motion,
      'rssi': rssi,
      'sat': sat,
      'status': status,
      'totalDistance': totalDistance,
    };
  }
}

