class ArrowStatus {
  String arrowNoConnection;
  String arrowStopped;
  String arrowMoving;
  String arrowEngineIdle;

  ArrowStatus({
    this.arrowNoConnection,
    this.arrowStopped,
    this.arrowMoving,
    this.arrowEngineIdle,
  });

  factory ArrowStatus.fromJson(Map<String, dynamic> json) {
    return ArrowStatus(
      arrowNoConnection: json['arrow_no_connection'],
      arrowStopped: json['arrow_stopped'],
      arrowMoving: json['arrow_moving'],
      arrowEngineIdle: json['arrow_engine_idle'],
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'arrow_no_connection': arrowNoConnection,
      'arrow_stopped': arrowStopped,
      'arrow_moving': arrowMoving,
      'arrow_engine_idle': arrowEngineIdle,
    };
  }
}

class FCR {
  String source;
  String measurement;
  String cost;
  String summer;
  String winter;
  String winterStart;
  String winterEnd;

  FCR({
    this.source,
    this.measurement,
    this.cost,
    this.summer,
    this.winter,
    this.winterStart,
    this.winterEnd,
  });

  factory FCR.fromJson(Map<String, dynamic> json) {
    return FCR(
      source: json['source'] as String,
      measurement: json['measurement'] as String,
      cost: json['cost'] as String,
      summer: json['summer'] as String,
      winter: json['winter'] as String,
      winterStart: json['winter_start'] as String,
      winterEnd: json['winter_end'] as String,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'source': source,
      'measurement': measurement,
      'cost': cost,
      'summer': summer,
      'winter': winter,
      'winter_start': winterStart,
      'winter_end': winterEnd,
    };
  }
}


class RouteSettings {
  String stops;
  String routeLength;
  String minMovingSpeed;
  String minIdleSpeed;
  String minDiffPoints;
  bool useGpsLev;
  String minGpsLev;
  bool useHdop;
  String maxHdop;
  bool ignFuelConsStops;
  String minFuelSpeed;
  String minFf;
  String minFt;

  RouteSettings({
    this.stops,
    this.routeLength,
    this.minMovingSpeed,
    this.minIdleSpeed,
    this.minDiffPoints,
    this.useGpsLev,
    this.minGpsLev,
    this.useHdop,
    this.maxHdop,
    this.ignFuelConsStops,
    this.minFuelSpeed,
    this.minFf,
    this.minFt,
  });

  factory RouteSettings.fromJson(Map<String, dynamic> json) {
    return RouteSettings(
      stops: json['stops'] as String,
      routeLength: json['route_length'] as String,
      minMovingSpeed: json['min_moving_speed'] as String,
      minIdleSpeed: json['min_idle_speed'] as String,
      minDiffPoints: json['min_diff_points'] as String,
      useGpsLev: json['use_gpslev'] as bool,
      minGpsLev: json['min_gpslev'] as String,
      useHdop: json['use_hdop'] as bool,
      maxHdop: json['max_hdop'] as String,
      ignFuelConsStops: json['ign_fuel_cons_stops'] as bool,
      minFuelSpeed: json['min_fuel_speed'] as String,
      minFf: json['min_ff'] as String,
      minFt: json['min_ft'] as String,
    );
  }

  Map<String, dynamic> toJson() {
    return {
      'stops': stops,
      'route_length': routeLength,
